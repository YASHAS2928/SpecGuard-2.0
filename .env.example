# Development-only mock Time-to-Pay API (start it from the repository root:
#   python -m uvicorn mock_api.main:app --host 127.0.0.1 --port 9000)
# Implementation served at start-up: 1.3.0 (overnight defect), 1.3.0-b (off-by-one), 1.3.0-c (double meal),
# 1.4.0 (correct, threshold 480) or 1.5.0 (announced change, threshold 450). Switch at runtime with
# POST /admin/version (loopback only).
MOCK_VERSION=1.4.0

# Shortest recorded meal break the mock deducts (default 30 = "Deduct only breaks of 30 minutes or more").
MOCK_MEAL_MIN=30
